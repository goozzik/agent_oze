<div class="max-w-4xl mx-auto">
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Edytuj ofertę <%= @offer.number %>
      </h2>
      <p class="mt-1 text-sm text-gray-500">Klient: <%= @lead.full_name %></p>
    </div>
    <div class="mt-4 flex md:mt-0 md:ml-4">
      <%= link_to "Wróć", [@lead, @offer], class: "bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400" %>
    </div>
  </div>

  <div class="mt-8 bg-white shadow rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <%= simple_form_for [@lead, @offer], html: { class: "space-y-6", id: "offer-form" } do |form| %>
        <%= form.input :description, 
            as: :text, 
            label: "Opis oferty", 
            input_html: { 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", 
              rows: 3,
              placeholder: "Krótki opis oferty, warunki, uwagi..."
            } %>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          <%= form.input :delivery_time, 
              label: "Czas realizacji", 
              input_html: { 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm",
                placeholder: "np. 2-3 tygodnie"
              } %>
              
          <%= form.input :warranty, 
              label: "Gwarancja", 
              input_html: { 
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm",
                placeholder: "np. 5 lat producenta"
              } %>
              
          <div></div>
        </div>

        <%= form.input :bonuses, 
            as: :text, 
            label: "Bonusy i dodatki", 
            input_html: { 
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm", 
              rows: 2,
              placeholder: "np. produkt premium DEFRO, dodatkowe akcesoria..."
            } %>

        <div class="border-t pt-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-medium text-gray-900">Pozycje oferty</h3>
            <button type="button" id="add-item" class="bg-green-600 text-white px-3 py-1 rounded text-sm hover:bg-green-700">
              + Dodaj pozycję
            </button>
          </div>

          <div id="offer-items" class="space-y-4">
            <%= form.simple_fields_for :offer_items do |item_form| %>
              <div class="offer-item bg-gray-50 p-4 rounded-lg">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
                  <div class="md:col-span-5">
                    <%= item_form.input :name, 
                        label: "Nazwa produktu/usługi", 
                        input_html: { 
                          class: "block w-full rounded-md border-gray-300 shadow-sm",
                          placeholder: "np. Piec pelletowy 20kW"
                        } %>
                  </div>
                  
                  <div class="md:col-span-2">
                    <%= item_form.input :qty, 
                        label: "Ilość", 
                        input_html: { 
                          class: "block w-full rounded-md border-gray-300 shadow-sm quantity-input",
                          type: "number",
                          min: "1",
                          step: "1",
                          value: "1"
                        } %>
                  </div>
                  
                  <div class="md:col-span-3">
                    <%= item_form.input :unit_price, 
                        label: "Cena jednostkowa (zł)", 
                        input_html: { 
                          class: "block w-full rounded-md border-gray-300 shadow-sm unit-price-input",
                          type: "number",
                          min: "0",
                          step: "0.01",
                          placeholder: "100.00"
                        } %>
                  </div>
                  
                  <div class="md:col-span-2 flex items-end">
                    <button type="button" class="remove-item bg-red-600 text-white px-3 py-2 rounded text-sm hover:bg-red-700 w-full">
                      Usuń
                    </button>
                    <%= item_form.input :_destroy, as: :hidden %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="bg-gray-50 p-4 rounded-lg">
          <div class="text-right">
            <span class="text-lg font-medium text-gray-900">Wartość całkowita: </span>
            <span id="total-value" class="text-2xl font-bold text-blue-600">0,00 zł</span>
          </div>
        </div>

        <div class="flex justify-end space-x-3">
          <%= link_to "Anuluj", [@lead, @offer], class: "bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400" %>
          <%= form.submit "Zaktualizuj ofertę", class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  // JavaScript for dynamic offer items (same as in new.html.erb)
  document.addEventListener('DOMContentLoaded', function() {
    let itemIndex = <%= @offer.offer_items.count %>;
    
    // Add item button
    document.getElementById('add-item').addEventListener('click', function() {
      const template = `
        <div class="offer-item bg-gray-50 p-4 rounded-lg">
          <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
            <div class="md:col-span-5">
              <label class="block text-sm font-medium text-gray-700">Nazwa produktu/usługi</label>
              <input type="text" name="offer[offer_items_attributes][${itemIndex}][name]" 
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm" 
                     placeholder="np. Piec pelletowy 20kW">
            </div>
            
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700">Ilość</label>
              <input type="number" name="offer[offer_items_attributes][${itemIndex}][qty]" 
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm quantity-input" 
                     min="1" step="1" value="1">
            </div>
            
            <div class="md:col-span-3">
              <label class="block text-sm font-medium text-gray-700">Cena jednostkowa (zł)</label>
              <input type="number" name="offer[offer_items_attributes][${itemIndex}][unit_price]" 
                     class="mt-1 block w-full rounded-md border-gray-300 shadow-sm unit-price-input" 
                     min="0" step="0.01" placeholder="100.00">
            </div>
            
            <div class="md:col-span-2 flex items-end">
              <button type="button" class="remove-item bg-red-600 text-white px-3 py-2 rounded text-sm hover:bg-red-700 w-full">
                Usuń
              </button>
            </div>
          </div>
        </div>
      `;
      
      document.getElementById('offer-items').insertAdjacentHTML('beforeend', template);
      itemIndex++;
      updateTotal();
    });
    
    // Remove item and calculate total
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('remove-item')) {
        const item = e.target.closest('.offer-item');
        const destroyInput = item.querySelector('input[name*="_destroy"]');
        
        if (destroyInput) {
          destroyInput.value = '1';
          item.style.display = 'none';
        } else {
          item.remove();
        }
        updateTotal();
      }
    });
    
    // Calculate total on input change
    document.addEventListener('input', function(e) {
      if (e.target.classList.contains('quantity-input') || e.target.classList.contains('unit-price-input')) {
        updateTotal();
      }
    });
    
    function updateTotal() {
      let total = 0;
      document.querySelectorAll('.offer-item:not([style*="display: none"])').forEach(function(item) {
        const qty = parseFloat(item.querySelector('.quantity-input').value) || 0;
        const price = parseFloat(item.querySelector('.unit-price-input').value) || 0;
        total += qty * price;
      });
      
      document.getElementById('total-value').textContent = total.toFixed(2).replace('.', ',') + ' zł';
    }
    
    // Initial calculation
    updateTotal();
  });
</script>