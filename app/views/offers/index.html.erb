<div class="max-w-7xl mx-auto">
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Wszystkie oferty
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Lista wszystkich ofert w systemie
      </p>
    </div>
  </div>

  <div class="mt-8 bg-white shadow rounded-lg overflow-hidden">
    <% if @offers.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Numer oferty
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Klient
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Status
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Wartość
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Data utworzenia
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Akcje
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @offers.each do |offer| %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900">
                    <%= offer.number %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm text-gray-900"><%= offer.lead.full_name %></div>
                  <div class="text-sm text-gray-500"><%= offer.lead.email %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
                    <%= case offer.status
                        when 'draft' then 'bg-gray-100 text-gray-800'
                        when 'sent' then 'bg-blue-100 text-blue-800'
                        when 'accepted' then 'bg-green-100 text-green-800'
                        when 'rejected' then 'bg-red-100 text-red-800'
                        else 'bg-gray-100 text-gray-800'
                        end %>">
                    <%= offer.status.humanize %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= offer.total %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= offer.created_at.strftime("%d.%m.%Y") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                  <%= link_to "Zobacz", [offer.lead, offer], 
                      class: "text-blue-600 hover:text-blue-900" %>
                  
                  <%= link_to "📄 PDF", download_pdf_lead_offer_path(offer.lead, offer), 
                      class: "text-red-600 hover:text-red-900" %>
                  
                  <% if offer.draft? %>
                    <%= link_to "📤 Wyślij", send_offer_lead_offer_path(offer.lead, offer), 
                        method: :post,
                        confirm: "Czy na pewno chcesz wysłać ofertę do klienta?",
                        class: "text-green-600 hover:text-green-900" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <div class="text-gray-500">
          <p class="text-lg font-medium">Brak ofert</p>
          <p class="mt-1">Oferty będą wyświetlane tutaj po ich utworzeniu.</p>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Stats section -->
  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-gray-100 rounded-md flex items-center justify-center">
              📝
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">
                Wszystkie oferty
              </dt>
              <dd class="text-lg font-medium text-gray-900">
                <%= @offers.count %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-blue-100 rounded-md flex items-center justify-center">
              📤
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">
                Wysłane
              </dt>
              <dd class="text-lg font-medium text-gray-900">
                <%= @offers.where(status: 'sent').count %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-green-100 rounded-md flex items-center justify-center">
              ✅
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">
                Zaakceptowane
              </dt>
              <dd class="text-lg font-medium text-gray-900">
                <%= @offers.where(status: 'accepted').count %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-yellow-100 rounded-md flex items-center justify-center">
              💰
            </div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">
                Całkowita wartość
              </dt>
              <dd class="text-lg font-medium text-gray-900">
                <%= Money.new(@offers.sum(:total_cents), 'PLN').format %>
              </dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
