<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Oferta <%= @offer.number %>
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Klient: <%= @lead.full_name %> • 
        <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full 
          <%= case @offer.status
              when 'draft' then 'bg-gray-100 text-gray-800'
              when 'sent' then 'bg-blue-100 text-blue-800'
              when 'accepted' then 'bg-green-100 text-green-800'
              when 'rejected' then 'bg-red-100 text-red-800'
              else 'bg-gray-100 text-gray-800'
              end %>">
          <%= @offer.status.humanize %>
        </span>
      </p>
    </div>
    
    <div class="mt-4 flex md:mt-0 md:ml-4 space-x-3">
      <% if @offer.draft? %>
        <%= button_to "📤 Wyślij ofertę", send_offer_lead_offer_path(@lead, @offer), 
            method: :post,
            confirm: "Czy na pewno chcesz wysłać ofertę do klienta?",
            class: "bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 border-0" %>
      <% end %>
      
      <%= link_to "📄 Pobierz PDF", download_pdf_lead_offer_path(@lead, @offer), 
          class: "bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700" %>
      
      <%= link_to "Edytuj", edit_lead_offer_path(@lead, @offer), 
          class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      
      <%= link_to "Wróć", @lead, class: "bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400" %>
    </div>
  </div>

  <!-- Main content -->
  <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Offer details -->
    <div class="lg:col-span-2">
      <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Szczegóły oferty</h3>
          
          <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
            <div>
              <dt class="text-sm font-medium text-gray-500">Numer oferty</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @offer.number %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Status</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @offer.status.humanize %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Data utworzenia</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @offer.created_at.strftime("%d.%m.%Y %H:%M") %></dd>
            </div>
            
            <% if @offer.sent_at %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Data wysłania</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @offer.sent_at.strftime("%d.%m.%Y %H:%M") %></dd>
              </div>
            <% end %>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Waluta</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @offer.currency %></dd>
            </div>
            
            <div>
              <dt class="text-sm font-medium text-gray-500">Wartość całkowita</dt>
              <dd class="mt-1 text-lg font-semibold text-blue-600"><%= @offer.total %></dd>
            </div>
            
            <% if @offer.delivery_time.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Czas realizacji</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @offer.delivery_time %></dd>
              </div>
            <% end %>
            
            <% if @offer.warranty.present? %>
              <div>
                <dt class="text-sm font-medium text-gray-500">Gwarancja</dt>
                <dd class="mt-1 text-sm text-gray-900"><%= @offer.warranty %></dd>
              </div>
            <% end %>
          </dl>
          
          <% if @offer.description.present? %>
            <div class="mt-6">
              <dt class="text-sm font-medium text-gray-500">Opis oferty</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= simple_format(@offer.description) %></dd>
            </div>
          <% end %>
          
          <% if @offer.bonuses.present? %>
            <div class="mt-6">
              <dt class="text-sm font-medium text-gray-500">Bonusy i dodatki</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= simple_format(@offer.bonuses) %></dd>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Offer items -->
      <% if @offer.offer_items.any? %>
        <div class="mt-6 bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Pozycje oferty</h3>
            
            <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
              <table class="min-w-full divide-y divide-gray-300">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nazwa</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Ilość</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Cena jedn.</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Wartość</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <% @offer.offer_items.each do |item| %>
                    <tr>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                        <%= item.name %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">
                        <%= item.qty %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-right">
                        <%= item.unit_price %>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 text-right">
                        <%= item.total_price %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
                <tfoot class="bg-gray-50">
                  <tr>
                    <td colspan="3" class="px-6 py-4 text-sm font-medium text-gray-900 text-right">
                      RAZEM:
                    </td>
                    <td class="px-6 py-4 text-sm font-bold text-blue-600 text-right">
                      <%= @offer.total %>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Customer info -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Dane klienta</h3>
          <div class="space-y-3">
            <div>
              <p class="font-medium text-gray-900"><%= @lead.full_name %></p>
              <p class="text-sm text-gray-500"><%= @lead.email %></p>
              <p class="text-sm text-gray-500"><%= @lead.phone %></p>
            </div>
            
            <% if @lead.address.present? %>
              <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Adres</p>
                <p class="text-sm text-gray-900"><%= @lead.address %></p>
              </div>
            <% end %>
            
            <% if @lead.product.present? %>
              <div>
                <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Produkt</p>
                <p class="text-sm text-gray-900"><%= @lead.product %></p>
              </div>
            <% end %>
          </div>
          
          <div class="mt-4">
            <%= link_to "Zobacz leada", @lead, class: "text-blue-600 hover:text-blue-800 text-sm" %>
          </div>
        </div>
      </div>
      
      <!-- Actions -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Akcje</h3>
          <div class="space-y-3">
            <% if @offer.draft? %>
              <%= button_to "📤 Wyślij do klienta", send_offer_lead_offer_path(@lead, @offer), 
                  method: :post,
                  confirm: "Czy na pewno chcesz wysłać ofertę do klienta?",
                  class: "w-full bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 text-center border-0" %>
            <% elsif @offer.sent? %>
              <div class="bg-blue-50 p-3 rounded-md">
                <p class="text-sm text-blue-700">
                  ✅ Oferta została wysłana <%= @offer.sent_at.strftime("%d.%m.%Y o %H:%M") %>
                </p>
                
                <% if @offer.decision_made? %>
                  <div class="mt-3 p-3 rounded-md
                    <%= case @offer.decision_status
                        when 'customer_yes' then 'bg-green-100'
                        when 'customer_no' then 'bg-red-100'  
                        when 'customer_maybe' then 'bg-yellow-100'
                        else 'bg-gray-100'
                        end %>">
                    <p class="text-sm font-medium
                      <%= case @offer.decision_status
                          when 'customer_yes' then 'text-green-800'
                          when 'customer_no' then 'text-red-800'  
                          when 'customer_maybe' then 'text-yellow-800'
                          else 'text-gray-800'
                          end %>">
                      <%= case @offer.decision_status
                          when 'customer_yes' then '🎉 Klient zaakceptował ofertę!'
                          when 'customer_no' then '😔 Klient odrzucił ofertę'
                          when 'customer_maybe' then '🤔 Klient potrzebuje więcej czasu'
                          else 'Decyzja podjęta'
                          end %>
                    </p>
                    <p class="text-xs mt-1
                      <%= case @offer.decision_status
                          when 'customer_yes' then 'text-green-600'
                          when 'customer_no' then 'text-red-600'  
                          when 'customer_maybe' then 'text-yellow-600'
                          else 'text-gray-600'
                          end %>">
                      Decyzja z <%= @offer.decision_made_at.strftime("%d.%m.%Y o %H:%M") %>
                    </p>
                    <% if @offer.customer_response.present? %>
                      <p class="text-xs mt-2
                        <%= case @offer.decision_status
                            when 'customer_yes' then 'text-green-600'
                            when 'customer_no' then 'text-red-600'  
                            when 'customer_maybe' then 'text-yellow-600'
                            else 'text-gray-600'
                            end %>">
                        💬 "<%= @offer.customer_response.truncate(100) %>"
                      </p>
                    <% end %>
                  </div>
                <% elsif @offer.awaiting_decision? %>
                  <div class="mt-3 p-3 bg-yellow-50 rounded-md">
                    <p class="text-sm text-yellow-800">
                      ⏳ Oczekuje na decyzję klienta
                    </p>
                    <% if @offer.decision_deadline %>
                      <p class="text-xs text-yellow-600 mt-1">
                        <% if @offer.decision_overdue? %>
                          ⚠️ Termin minął <%= @offer.decision_deadline.strftime("%d.%m.%Y") %>
                        <% elsif @offer.days_until_decision_deadline <= 3 %>
                          ⏰ Zostało <%= @offer.days_until_decision_deadline %> dni
                        <% else %>
                          📅 Termin: <%= @offer.decision_deadline.strftime("%d.%m.%Y") %>
                        <% end %>
                      </p>
                    <% end %>
                    <a href="<%= customer_decision_offer_url(@offer) %>" 
                       class="text-xs text-blue-600 hover:text-blue-800 mt-2 inline-block">
                      🔗 Link dla klienta
                    </a>
                  </div>
                <% end %>
              </div>
            <% end %>
            
            <%= link_to "📄 Pobierz PDF", download_pdf_lead_offer_path(@lead, @offer), 
                class: "w-full bg-red-600 text-white px-4 py-2 rounded-md hover:bg-red-700 block text-center" %>
            
            <%= link_to "✏️ Edytuj ofertę", edit_lead_offer_path(@lead, @offer), 
                class: "w-full bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 block text-center" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
