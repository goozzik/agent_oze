      <!-- Lost -->
      <div class="pipeline-column bg-white rounded-lg shadow-sm p-4 flex-shrink-0" data-status="lost" style="width: 220px;">
        <div class="pipeline-header mb-4">
          <h3 class="font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 bg-red-400 rounded-full mr-2"></span>
            Przegrane
            <span class="ml-2 bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full">
              <%= @pipeline_data['lost'].count %>
            </span>
          </h3>
        </div>
        <div class="pipeline-items space-y-3" data-status="lost">
