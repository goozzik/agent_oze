      <!-- Offer Sent -->
      <div class="pipeline-column bg-white rounded-lg shadow-sm p-4 flex-shrink-0" data-status="offer" style="width: 220px;">
        <div class="pipeline-header mb-4">
          <h3 class="font-semibold text-gray-900 flex items-center">
            <span class="w-3 h-3 bg-yellow-400 rounded-full mr-2"></span>
            Oferta
            <span class="ml-2 bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full">
