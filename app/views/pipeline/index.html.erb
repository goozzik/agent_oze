              <dd class="text-lg font-medium text-green-600"><%= number_to_currency(@total_value['won'], unit: "zł", precision: 0) %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pipeline Board -->
    <div class="flex gap-6 overflow-x-auto pb-4" id="pipeline-board">
      
      <!-- Fresh Leads -->
      <div class="pipeline-column bg-white rounded-lg shadow-sm p-4 flex-shrink-0" data-status="fresh" style="width: 220px;">
        <div class="pipeline-header mb-4">
