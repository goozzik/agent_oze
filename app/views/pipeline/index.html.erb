            <div class="text-2xl">🤝</div>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">W negocjacjach</dt>
              <dd class="text-lg font-medium text-gray-900"><%= number_to_currency(@total_value['negotiation'], unit: "zł", precision: 0) %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white overflow-hidden shadow rounded-lg">
