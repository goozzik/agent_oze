      </div>

    </div>
</div>

<!-- Drag and Drop JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const columns = document.querySelectorAll('.pipeline-items');
  
  columns.forEach(column => {
    new Sortable(column, {
      group: 'pipeline',
      animation: 150,
      ghostClass: 'sortable-ghost',
      chosenClass: 'sortable-chosen',
      dragClass: 'sortable-drag',
      
      onEnd: function(evt) {
        const leadId = evt.item.dataset.leadId;
        const newStatus = evt.to.dataset.status;
        const oldStatus = evt.from.dataset.status;
        
        if (newStatus !== oldStatus) {
          updateLeadStatus(leadId, newStatus, evt.item, evt.from);
        }
      }
    });
  });
  
  function updateLeadStatus(leadId, newStatus, cardElement, oldColumn) {
    // Show loading state
    cardElement.style.opacity = '0.5';
    
    fetch(`/pipeline/${leadId}/update_status`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({
        status: newStatus
      })
    })
    .then(response => response.json())
    .then(data => {
      if (data.status === 'success') {
        // Update counters
        updateColumnCounters();
        cardElement.style.opacity = '1';
        
        // Show success message
        showNotification('Lead moved successfully!', 'success');
      } else {
        // Revert the move
        oldColumn.appendChild(cardElement);
        cardElement.style.opacity = '1';
        showNotification(data.message || 'Failed to update lead', 'error');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      // Revert the move
      oldColumn.appendChild(cardElement);
      cardElement.style.opacity = '1';
      showNotification('Network error occurred', 'error');
    });
  }
  
  function updateColumnCounters() {
    columns.forEach(column => {
      const status = column.dataset.status;
      const count = column.children.length;
      const header = column.parentElement.querySelector('.pipeline-header span:last-child');
      if (header) {
        header.textContent = count;
      }
    });
  }
  
  function showNotification(message, type) {
    const notification = document.createElement('div');
    notification.className = `fixed top-4 right-4 px-4 py-2 rounded-md text-white z-50 ${
      type === 'success' ? 'bg-green-600' : 'bg-red-600'
    }`;
    notification.textContent = message;
    
    document.body.appendChild(notification);
    
    setTimeout(() => {
      notification.remove();
    }, 3000);
  }
});
</script>

<style>
.sortable-ghost {
  opacity: 0.4;
}

.sortable-chosen {
  transform: rotate(5deg);
}

.sortable-drag {
  transform: rotate(5deg);
}

.pipeline-column {
  min-height: 300px;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.pipeline-items {
  flex-grow: 1;
  overflow-y: auto;
  padding-right: 8px;
  max-height: calc(70vh - 80px); /* wysokość kolumny minus header */
}

/* Custom scrollbar for pipeline columns - only visible when hovering */
.pipeline-items {
  scrollbar-width: thin;
  scrollbar-color: transparent transparent;
}

.pipeline-items:hover {
  scrollbar-color: #c1c1c1 transparent;
}

.pipeline-items::-webkit-scrollbar {
  width: 4px;
}

.pipeline-items::-webkit-scrollbar-track {
  background: transparent;
}

.pipeline-items::-webkit-scrollbar-thumb {
  background: transparent;
  border-radius: 2px;
}

.pipeline-items:hover::-webkit-scrollbar-thumb {
  background: #c1c1c1;
}

.pipeline-items::-webkit-scrollbar-thumb:hover {
  background: #a1a1a1;
}

/* Kanban board styling */
#pipeline-board {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12px;
  padding: 20px;
}

.pipeline-column {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Responsive adjustments for mobile */
@media (max-width: 768px) {
  .pipeline-column {
    width: 200px !important;
  }
  
  #pipeline-board {
    padding: 15px;
    gap: 12px;
  }
}
</style>