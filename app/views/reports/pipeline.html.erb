<div class="max-w-7xl mx-auto">
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Pipeline sprzedażowy
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Przegląd procesu sprzedażowego i konwersji
      </p>
    </div>
  </div>

  <!-- Pipeline Overview -->
  <div class="mt-8">
    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Etapy sprzedaży</h3>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      <!-- Fresh Leads -->
      <div class="bg-gray-50 overflow-hidden shadow rounded-lg border-l-4 border-gray-400">
        <div class="p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-gray-100 rounded-md flex items-center justify-center">
                🆕
              </div>
            </div>
            <div class="ml-3 w-0 flex-1">
              <dl>
                <dt class="text-xs font-medium text-gray-500 truncate uppercase tracking-wider">
                  Nowe
                </dt>
                <dd class="text-lg font-semibold text-gray-900">
                  <%= @pipeline_stats[:fresh] %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Contacted -->
      <div class="bg-blue-50 overflow-hidden shadow rounded-lg border-l-4 border-blue-400">
        <div class="p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-blue-100 rounded-md flex items-center justify-center">
                📞
              </div>
            </div>
            <div class="ml-3 w-0 flex-1">
              <dl>
                <dt class="text-xs font-medium text-gray-500 truncate uppercase tracking-wider">
                  Kontakt
                </dt>
                <dd class="text-lg font-semibold text-gray-900">
                  <%= @pipeline_stats[:contacted] %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Meeting Scheduled -->
      <div class="bg-purple-50 overflow-hidden shadow rounded-lg border-l-4 border-purple-400">
        <div class="p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-purple-100 rounded-md flex items-center justify-center">
                📅
              </div>
            </div>
            <div class="ml-3 w-0 flex-1">
              <dl>
                <dt class="text-xs font-medium text-gray-500 truncate uppercase tracking-wider">
                  Spotkanie
                </dt>
                <dd class="text-lg font-semibold text-gray-900">
                  <%= @pipeline_stats[:meeting] %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Offer Sent -->
      <div class="bg-yellow-50 overflow-hidden shadow rounded-lg border-l-4 border-yellow-400">
        <div class="p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-yellow-100 rounded-md flex items-center justify-center">
                📄
              </div>
            </div>
            <div class="ml-3 w-0 flex-1">
              <dl>
                <dt class="text-xs font-medium text-gray-500 truncate uppercase tracking-wider">
                  Oferta
                </dt>
                <dd class="text-lg font-semibold text-gray-900">
                  <%= @pipeline_stats[:offer] %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Won -->
      <div class="bg-green-50 overflow-hidden shadow rounded-lg border-l-4 border-green-400">
        <div class="p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-green-100 rounded-md flex items-center justify-center">
                ✅
              </div>
            </div>
            <div class="ml-3 w-0 flex-1">
              <dl>
                <dt class="text-xs font-medium text-gray-500 truncate uppercase tracking-wider">
                  Wygrane
                </dt>
                <dd class="text-lg font-semibold text-gray-900">
                  <%= @pipeline_stats[:won] %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Lost -->
      <div class="bg-red-50 overflow-hidden shadow rounded-lg border-l-4 border-red-400">
        <div class="p-4">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-red-100 rounded-md flex items-center justify-center">
                ❌
              </div>
            </div>
            <div class="ml-3 w-0 flex-1">
              <dl>
                <dt class="text-xs font-medium text-gray-500 truncate uppercase tracking-wider">
                  Przegrane
                </dt>
                <dd class="text-lg font-semibold text-gray-900">
                  <%= @pipeline_stats[:lost] %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pipeline Value -->
  <div class="mt-8">
    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Wartość w pipeline</h3>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-purple-100 rounded-md flex items-center justify-center">
                📅
              </div>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">
                  Spotkania (potencjalna wartość)
                </dt>
                <dd class="text-2xl font-semibold text-gray-900">
                  <%= @pipeline_value[:meeting].format %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-yellow-100 rounded-md flex items-center justify-center">
                📄
              </div>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">
                  Oferty (oczekujące)
                </dt>
                <dd class="text-2xl font-semibold text-gray-900">
                  <%= @pipeline_value[:offer].format %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-green-100 rounded-md flex items-center justify-center">
                ✅
              </div>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">
                  Wygrane (zrealizowane)
                </dt>
                <dd class="text-2xl font-semibold text-gray-900">
                  <%= @pipeline_value[:won].format %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Activities -->
  <div class="mt-8">
    <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Ostatnie aktywności</h3>
    <div class="bg-white shadow rounded-lg">
      <div class="p-6">
        <div class="flow-root">
          <ul class="-mb-8">
            <% @recent_activities.each_with_index do |activity, index| %>
              <li>
                <div class="relative pb-8">
                  <% unless index == @recent_activities.length - 1 %>
                    <span class="absolute top-5 left-5 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                  <% end %>
                  <div class="relative flex items-start space-x-3">
                    <div class="relative">
                      <div class="w-10 h-10 bg-<%= activity[:color] %>-100 rounded-full flex items-center justify-center">
                        <span class="text-<%= activity[:color] %>-600"><%= activity[:icon] %></span>
                      </div>
                    </div>
                    <div class="min-w-0 flex-1">
                      <div>
                        <div class="text-sm">
                          <span class="font-medium text-gray-900"><%= activity[:title] %></span>
                        </div>
                        <p class="mt-0.5 text-sm text-gray-500">
                          <%= time_ago_in_words(activity[:time]) %> temu
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>