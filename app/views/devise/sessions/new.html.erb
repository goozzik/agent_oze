<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <div class="mx-auto h-16 w-16 bg-blue-600 rounded-full flex items-center justify-center">
        <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        Zaloguj się do AgentOze
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        System sprzedaży pieców pelletowych
      </p>
    </div>

    <div class="bg-white shadow-lg rounded-lg px-8 py-8">
      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
        <div class="space-y-4">
          <%= f.input :email,
                      label: "Adres email",
                      required: false,
                      autofocus: true,
                      input_html: { 
                        autocomplete: "email",
                        class: "appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm"
                      },
                      wrapper_html: { class: "form-group" },
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" } %>
          
          <%= f.input :password,
                      label: "Hasło",
                      required: false,
                      input_html: { 
                        autocomplete: "current-password",
                        class: "appearance-none relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 rounded-md focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm"
                      },
                      wrapper_html: { class: "form-group" },
                      label_html: { class: "block text-sm font-medium text-gray-700 mb-1" } %>
          
          <% if devise_mapping.rememberable? %>
            <div class="flex items-center">
              <%= f.input :remember_me, 
                          as: :boolean, 
                          label: "Zapamiętaj mnie",
                          input_html: { 
                            class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                          },
                          wrapper_html: { class: "flex items-center" },
                          label_html: { class: "ml-2 block text-sm text-gray-900" } %>
            </div>
          <% end %>
        </div>

        <div>
          <%= f.button :submit, "Zaloguj się", 
                      class: "group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150 ease-in-out" %>
        </div>
      <% end %>

      <div class="mt-6">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
