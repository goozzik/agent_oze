<div class="text-center space-y-2">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Zaloguj się", new_session_path(resource_name), 
        class: "text-sm text-blue-600 hover:text-blue-500" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Zarejestruj się", new_registration_path(resource_name), 
        class: "block text-sm text-blue-600 hover:text-blue-500" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Zapomniałeś hasła?", new_password_path(resource_name), 
        class: "block text-sm text-blue-600 hover:text-blue-500" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "Nie otrzymałeś instrukcji potwierdzenia?", new_confirmation_path(resource_name), 
        class: "block text-sm text-blue-600 hover:text-blue-500" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "Nie otrzymałeś instrukcji odblokowania?", new_unlock_path(resource_name), 
        class: "block text-sm text-blue-600 hover:text-blue-500" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Zaloguj przez #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), 
          data: { turbo: false }, 
          class: "mt-2 w-full flex justify-center py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
    <% end %>
  <% end %>
</div>
