<div class="max-w-6xl mx-auto">
  <div class="md:flex md:items-center md:justify-between mb-6">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate flex items-center">
        <span class="mr-3">📊</span>
        Raport Audytu Energetycznego
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        AI Analiza budynku dla: <strong><%= @lead.full_name %></strong> | <%= @energy_audit.created_at.strftime("%d.%m.%Y %H:%M") %>
      </p>
    </div>
    <div class="mt-4 flex md:mt-0 md:ml-4 space-x-2">
      <%= link_to "Edytuj", edit_lead_energy_audit_path(@lead, @energy_audit), 
          class: "bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700" %>
      <%= link_to "Wróć", @lead, class: "bg-gray-300 text-gray-700 px-4 py-2 rounded-md hover:bg-gray-400" %>
    </div>
  </div>

  <% if @audit_report %>
    <!-- Energy Class Badge -->
    <div class="mb-6 flex justify-center">
      <div class="inline-flex items-center px-8 py-4 rounded-lg text-2xl font-bold
        <%= case @energy_audit.energy_class
            when 'A+', 'A' then 'bg-green-100 text-green-800'
            when 'B', 'C' then 'bg-yellow-100 text-yellow-800'
            when 'D', 'E' then 'bg-orange-100 text-orange-800'
            else 'bg-red-100 text-red-800'
            end %>">
        <span class="mr-2">🏠</span>
        Klasa Energetyczna: <%= @energy_audit.energy_class %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Building Information -->
      <div class="lg:col-span-1">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
              <span class="mr-2">🏗️</span>
              Dane budynku
            </h3>
            
            <dl class="space-y-3">
              <div>
                <dt class="text-sm font-medium text-gray-500">Rok budowy</dt>
                <dd class="text-sm text-gray-900"><%= @audit_report['building_info']['construction_year'] %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Powierzchnia użytkowa</dt>
                <dd class="text-sm text-gray-900"><%= @audit_report['building_info']['usable_area'] %> m²</dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Obecne źródło ciepła</dt>
                <dd class="text-sm text-gray-900"><%= @audit_report['building_info']['current_heat_source'] %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Stan budynku</dt>
                <dd class="text-sm text-gray-900"><%= @audit_report['building_info']['house_condition'] %></dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500">Typ wentylacji</dt>
                <dd class="text-sm text-gray-900"><%= @audit_report['building_info']['ventilation_type'] %></dd>
              </div>
              <% if @energy_audit.location_info.present? %>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Lokalizacja</dt>
                  <dd class="text-sm text-gray-900"><%= @energy_audit.location_info %></dd>
                </div>
              <% end %>
              <% if @energy_audit.building_registry_number.present? %>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Numer działki</dt>
                  <dd class="text-sm text-gray-900"><%= @energy_audit.building_registry_number %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        </div>

        <!-- Clean Air Qualification -->
        <div class="mt-6 bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
              <span class="mr-2">🌱</span>
              Program "Czyste Powietrze"
            </h3>
            
            <% if @energy_audit.current_heat_source == 'coal' %>
              <div class="bg-green-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <div class="text-green-400 mr-3">✅</div>
                  <div>
                    <h4 class="text-sm font-medium text-green-800">Kwalifikuje się</h4>
                    <p class="text-sm text-green-700 mt-1">
                      Budynek z kotłem węglowym kwalifikuje się do dotacji na wymianę źródła ciepła.
                    </p>
                  </div>
                </div>
              </div>
            <% elsif @energy_audit.current_heat_source == 'oil' %>
              <div class="bg-yellow-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <div class="text-yellow-400 mr-3">⚠️</div>
                  <div>
                    <h4 class="text-sm font-medium text-yellow-800">Może kwalifikować się</h4>
                    <p class="text-sm text-yellow-700 mt-1">
                      Wymaga dodatkowej weryfikacji wieku kotła i parametrów emisji.
                    </p>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center">
                  <div class="text-gray-400 mr-3">ℹ️</div>
                  <div>
                    <h4 class="text-sm font-medium text-gray-800">Termomodernizacja</h4>
                    <p class="text-sm text-gray-700 mt-1">
                      Możliwa dotacja na termomodernizację (docieplenie, okna, wentylacja).
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Energy Analysis -->
      <div class="lg:col-span-2">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
              <span class="mr-2">⚡</span>
              Analiza energetyczna
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <div class="text-center p-4 bg-blue-50 rounded-lg">
                <div class="text-2xl font-bold text-blue-900">
                  <%= number_with_delimiter(@audit_report['energy_analysis']['annual_demand']) %>
                </div>
                <div class="text-sm text-blue-600">kWh/rok</div>
                <div class="text-xs text-blue-500 mt-1">Zapotrzebowanie roczne</div>
              </div>
              <div class="text-center p-4 bg-green-50 rounded-lg">
                <div class="text-2xl font-bold text-green-900">
                  <%= @audit_report['energy_analysis']['demand_per_m2'] %>
                </div>
                <div class="text-sm text-green-600">kWh/m²/rok</div>
                <div class="text-xs text-green-500 mt-1">Na metr kwadratowy</div>
              </div>
              <div class="text-center p-4 bg-purple-50 rounded-lg">
                <div class="text-2xl font-bold text-purple-900">
                  <%= @energy_audit.energy_class %>
                </div>
                <div class="text-sm text-purple-600">Klasa</div>
                <div class="text-xs text-purple-500 mt-1">Energetyczna</div>
              </div>
            </div>

            <!-- Professional EP/EC/ET Calculations -->
            <% if @professional_calcs %>
              <div class="bg-purple-50 p-4 rounded-lg mb-6 border border-purple-200">
                <h4 class="text-lg font-medium text-purple-900 mb-3 flex items-center">
                  <span class="mr-2">🎯</span>
                  Profesjonalne kalkulacje energetyczne (EP/EC/ET)
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <div class="text-center p-3 bg-white rounded-lg border">
                    <div class="text-lg font-bold text-red-700">
                      <%= @professional_calcs[:et] %>
                    </div>
                    <div class="text-xs text-red-600">kWh/m²/rok</div>
                    <div class="text-xs text-red-500 mt-1">ET - Straty transmisji</div>
                  </div>
                  <div class="text-center p-3 bg-white rounded-lg border">
                    <div class="text-lg font-bold text-orange-700">
                      <%= @professional_calcs[:ec] %>
                    </div>
                    <div class="text-xs text-orange-600">kWh/m²/rok</div>
                    <div class="text-xs text-orange-500 mt-1">EC - Energia końcowa</div>
                  </div>
                  <div class="text-center p-3 bg-white rounded-lg border">
                    <div class="text-lg font-bold text-purple-700">
                      <%= @professional_calcs[:ep] %>
                    </div>
                    <div class="text-xs text-purple-600">kWh/m²/rok</div>
                    <div class="text-xs text-purple-500 mt-1">EP - Energia pierwotna</div>
                  </div>
                </div>
              </div>
            <% end %>

            <!-- Investment Scenarios (Before/After) -->
            <% if @investment_scenarios %>
              <div class="bg-yellow-50 p-4 rounded-lg mb-6 border border-yellow-200">
                <h4 class="text-lg font-medium text-yellow-900 mb-3 flex items-center">
                  <span class="mr-2">📊</span>
                  Porównanie przed/po inwestycji
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Before -->
                  <div class="bg-white p-4 rounded-lg border">
                    <h5 class="font-medium text-gray-800 mb-3">🔴 PRZED modernizacją</h5>
                    <div class="space-y-2 text-sm">
                      <div class="flex justify-between">
                        <span>EP:</span>
                        <span class="font-mono"><%= @investment_scenarios[:before][:ep] %> kWh/m²/rok</span>
                      </div>
                      <div class="flex justify-between">
                        <span>EC:</span>
                        <span class="font-mono"><%= @investment_scenarios[:before][:ec] %> kWh/m²/rok</span>
                      </div>
                      <div class="flex justify-between">
                        <span>Klasa energetyczna:</span>
                        <span class="font-bold text-red-600"><%= @investment_scenarios[:before][:energy_class] %></span>
                      </div>
                      <div class="flex justify-between">
                        <span>Sprawność systemu:</span>
                        <span><%= @investment_scenarios[:before][:system_efficiency] %>%</span>
                      </div>
                    </div>
                  </div>

                  <!-- After -->
                  <div class="bg-white p-4 rounded-lg border">
                    <h5 class="font-medium text-gray-800 mb-3">🟢 PO modernizacji</h5>
                    <div class="space-y-2 text-sm">
                      <div class="flex justify-between">
                        <span>EP:</span>
                        <span class="font-mono"><%= @investment_scenarios[:after][:ep] %> kWh/m²/rok</span>
                      </div>
                      <div class="flex justify-between">
                        <span>EC:</span>
                        <span class="font-mono"><%= @investment_scenarios[:after][:ec] %> kWh/m²/rok</span>
                      </div>
                      <div class="flex justify-between">
                        <span>Klasa energetyczna:</span>
                        <span class="font-bold text-green-600"><%= @investment_scenarios[:after][:energy_class] %></span>
                      </div>
                      <div class="flex justify-between">
                        <span>Sprawność systemu:</span>
                        <span><%= @investment_scenarios[:after][:system_efficiency] %>%</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Savings Summary -->
                <% if @investment_scenarios[:savings] %>
                  <div class="mt-4 p-3 bg-green-100 rounded-lg">
                    <h5 class="font-medium text-green-800 mb-2">💰 Oszczędności energetyczne</h5>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                      <div class="text-center">
                        <div class="font-bold text-green-700">
                          <%= @investment_scenarios[:savings][:ep_reduction] %>
                        </div>
                        <div class="text-green-600">kWh/m²/rok EP</div>
                      </div>
                      <div class="text-center">
                        <div class="font-bold text-green-700">
                          <%= @investment_scenarios[:savings][:ec_reduction] %>
                        </div>
                        <div class="text-green-600">kWh/m²/rok EC</div>
                      </div>
                      <div class="text-center">
                        <div class="font-bold text-green-700">
                          <%= @investment_scenarios[:savings][:percentage_savings] %>%
                        </div>
                        <div class="text-green-600">Redukcja EP</div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Cost Analysis -->
            <% if @audit_report['cost_analysis'] && @audit_report['cost_analysis']['proposed'] %>
              <div class="bg-blue-50 p-4 rounded-lg mb-6 border border-blue-200">
                <h4 class="text-lg font-medium text-blue-900 mb-3 flex items-center">
                  <span class="mr-2">💵</span>
                  Analiza kosztów i zwrotu inwestycji
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <!-- Current Costs -->
                  <div class="bg-white p-4 rounded-lg border">
                    <h5 class="font-medium text-gray-800 mb-3">Obecne koszty roczne</h5>
                    <div class="space-y-2 text-sm">
                      <div class="flex justify-between">
                        <span>Zużycie:</span>
                        <span><%= number_with_delimiter(@audit_report['cost_analysis']['current']['annual_consumption_kwh']) %> kWh/rok</span>
                      </div>
                      <div class="flex justify-between">
                        <span>Paliwo:</span>
                        <span><%= @audit_report['cost_analysis']['current']['fuel_type'].capitalize %></span>
                      </div>
                      <div class="flex justify-between font-bold text-lg">
                        <span>Koszt roczny:</span>
                        <span class="text-red-600"><%= number_with_delimiter(@audit_report['cost_analysis']['current']['annual_cost']) %> PLN</span>
                      </div>
                    </div>
                  </div>

                  <!-- Proposed Costs -->
                  <div class="bg-white p-4 rounded-lg border">
                    <h5 class="font-medium text-gray-800 mb-3">Po modernizacji</h5>
                    <div class="space-y-2 text-sm">
                      <div class="flex justify-between">
                        <span>Zużycie:</span>
                        <span><%= number_with_delimiter(@audit_report['cost_analysis']['proposed']['annual_consumption_kwh']) %> kWh/rok</span>
                      </div>
                      <div class="flex justify-between">
                        <span>Paliwo:</span>
                        <span><%= @audit_report['cost_analysis']['proposed']['fuel_type'].capitalize %></span>
                      </div>
                      <div class="flex justify-between font-bold text-lg">
                        <span>Koszt roczny:</span>
                        <span class="text-green-600"><%= number_with_delimiter(@audit_report['cost_analysis']['proposed']['annual_cost']) %> PLN</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Investment ROI -->
                <% if @audit_report['cost_analysis']['savings'] %>
                  <div class="mt-4 p-4 bg-green-100 rounded-lg">
                    <h5 class="font-medium text-green-800 mb-3">🎯 Zwrot z inwestycji</h5>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-sm text-center">
                      <div>
                        <div class="text-lg font-bold text-green-700">
                          <%= number_with_delimiter(@audit_report['cost_analysis']['savings']['annual_savings_pln']) %> PLN
                        </div>
                        <div class="text-green-600">Oszczędność/rok</div>
                      </div>
                      <div>
                        <div class="text-lg font-bold text-green-700">
                          <%= @audit_report['cost_analysis']['savings']['percentage_savings'] %>%
                        </div>
                        <div class="text-green-600">Redukcja kosztów</div>
                      </div>
                      <div>
                        <div class="text-lg font-bold text-blue-700">
                          <%= @audit_report['cost_analysis']['investment']['payback_period_years'] if @audit_report['cost_analysis']['investment'] %>
                        </div>
                        <div class="text-blue-600">Lat zwrotu</div>
                      </div>
                      <div>
                        <div class="text-lg font-bold text-purple-700">
                          <%= number_with_delimiter(@audit_report['cost_analysis']['investment']['lifetime_savings_20_years']) if @audit_report['cost_analysis']['investment'] %> PLN
                        </div>
                        <div class="text-purple-600">Zysk 20 lat</div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Recommendations -->
            <div class="mt-6">
              <h4 class="text-lg font-medium text-gray-900 mb-3 flex items-center">
                <span class="mr-2">💡</span>
                Rekomendacje AI
              </h4>
              <div class="bg-yellow-50 p-4 rounded-lg">
                <div class="text-sm text-yellow-800 space-y-2">
                  <% @energy_audit.recommendations.split("\n").each do |recommendation| %>
                    <div class="flex items-start">
                      <span class="mr-2 mt-1">•</span>
                      <span><%= recommendation %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Additional Details -->
            <% if @energy_audit.insulation_info.present? || @energy_audit.planned_investments.present? %>
              <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                <% if @energy_audit.insulation_info.present? %>
                  <div>
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Informacje o izolacji</h4>
                    <div class="text-sm text-gray-600 bg-gray-50 p-3 rounded">
                      <%= simple_format(@energy_audit.insulation_info) %>
                    </div>
                  </div>
                <% end %>
                
                <% if @energy_audit.planned_investments.present? %>
                  <div>
                    <h4 class="text-sm font-medium text-gray-900 mb-2">Planowane inwestycje</h4>
                    <div class="text-sm text-gray-600 bg-gray-50 p-3 rounded">
                      <%= simple_format(@energy_audit.planned_investments) %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center">
              <span class="mr-2">🎯</span>
              Następne kroki
            </h3>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              <%= link_to "📋 Stwórz ofertę", new_lead_offer_path(@lead), 
                  class: "flex items-center justify-center px-4 py-3 border border-blue-300 text-sm font-medium rounded-md text-blue-700 bg-blue-50 hover:bg-blue-100" %>
              
              <%= link_to "📅 Umów spotkanie", new_lead_meeting_path(@lead), 
                  class: "flex items-center justify-center px-4 py-3 border border-green-300 text-sm font-medium rounded-md text-green-700 bg-green-50 hover:bg-green-100" %>
              
              <%= link_to "📊 Eksportuj PDF", download_pdf_lead_energy_audit_path(@lead, @energy_audit, format: :pdf), 
                  class: "flex items-center justify-center px-4 py-3 border border-purple-300 text-sm font-medium rounded-md text-purple-700 bg-purple-50 hover:bg-purple-100" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <span class="text-yellow-400">⚠️</span>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-yellow-800">
            Audyt nie został jeszcze przeanalizowany
          </h3>
          <p class="mt-2 text-sm text-yellow-700">
            Wygeneruj raport ponownie klikając poniższy przycisk.
          </p>
          <div class="mt-4">
            <%= button_to "🚀 Generuj raport AI", [@lead, @energy_audit], method: :patch,
                class: "bg-yellow-600 text-white px-4 py-2 rounded-md hover:bg-yellow-700" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
